# Local Supabase CLI
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (Vercel) — use your Supabase cloud project + Render API URL:
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_API_URL=https://resparts-api.onrender.com

# Public origin used to build alert links. https only, except localhost.
# NEXT_PUBLIC_SITE_URL=https://resparts.vercel.app

# Price alerts. Leave the secrets empty here. Generate them with: openssl rand -base64 32
# Do not prefix secrets with NEXT_PUBLIC_. See docs/ALERTS_SETUP_CHECKLIST.md.
# EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM=alerts@mail.example.com
# EMAIL_REPLY_TO=you@example.com
# EMAIL_WEBHOOK_SECRET=
# EMAIL_ALLOW_REAL_SEND_NON_PROD=false
# ALERT_HASH_SECRET=
# ALERT_TOKEN_SECRET=
# ALERT_TOKEN_SECRET_PREVIOUS=
# CRON_SECRET=
# ALERT_MIN_CHANGE_ILS=30
# ALERT_MIN_CHANGE_PERCENT=3
# ALERT_COOLDOWN_HOURS=24
# ALERT_BATCH_SIZE=200
# ALERT_MAX_PER_EMAIL=5
# ALERT_MAX_FAILURES=5
# ALERT_CONFIRM_TTL_HOURS=48
# ALERT_RETENTION_DAYS=365
# ALERT_MAX_CONFIRMATIONS_PER_DAY=2000
# ALERT_AD_LABEL_ENABLED=false
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_ALLOWED_HOSTS=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# ALERT_RATE_LIMIT=memory
