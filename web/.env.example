# Public site environment. Copy to .env.local for development. Never commit real values.
# Variables marked (Phase N) are optional until that phase.

# Required now. Must be https in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Required. Use the new publishable key (sb_publishable_...), not the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used in exactly one module (click logging). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Attribution (Phase 4)
TRACKING_UTM_SOURCE=
# At least 32 random characters, e.g. `openssl rand -base64 48`
CLICK_HASH_SECRET=

# Rate limiting (Phase 4)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bot protection (Phase 5)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cache refresh from the admin (Phase 6). At least 32 random characters.
REVALIDATE_SECRET=

# Monitoring (Phase 6)
SENTRY_DSN=

# Price freshness windows are set in the database: catalog.settings.
